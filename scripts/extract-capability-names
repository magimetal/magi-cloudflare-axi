#!/usr/bin/env python3
"""Read-only registered-name validator for exact pinned Cloudflare source."""
import json
import pathlib
import re
import subprocess
import sys

COMMIT = "70ff690553722f731849ede6ba9ce98958395a23"
CALL_PREFIX = r"(?<![\w$.])(?:context\.)?"
REGISTER = re.compile(
    CALL_PREFIX
    + r"(?:registerTool|accountTool|zoneTool)(?:<[^>]+>)?\s*\(\s*"
    r"(?:\{\s*)?(?:name\s*:\s*)?['\"]([^'\"$]+)"
)


def previous_code_index(text, code, index):
    cursor = index - 1
    while cursor >= 0 and (text[cursor].isspace() or not code[cursor]):
        cursor -= 1
    return cursor


def preceding_identifier(text, code, index):
    cursor = previous_code_index(text, code, index)
    end = cursor + 1
    while cursor >= 0 and code[cursor] and (text[cursor].isalnum() or text[cursor] in "_$"):
        cursor -= 1
    return text[cursor + 1 : end]


def regex_can_start(text, code, index):
    """Recognize JavaScript regex literals where an expression may begin."""
    cursor = previous_code_index(text, code, index)
    if cursor < 0 or text[cursor] in "([{=:,;!?&|+-*%^~<>":
        return True
    if text[cursor] == ")":
        depth = 1
        cursor -= 1
        while cursor >= 0:
            if code[cursor]:
                if text[cursor] == ")":
                    depth += 1
                elif text[cursor] == "(":
                    depth -= 1
                    if depth == 0:
                        return preceding_identifier(text, code, cursor) in {
                            "catch",
                            "for",
                            "if",
                            "switch",
                            "while",
                            "with",
                        }
            cursor -= 1
        return False
    return preceding_identifier(text, code, index) in {
        "await",
        "case",
        "delete",
        "else",
        "in",
        "instanceof",
        "of",
        "return",
        "throw",
        "typeof",
        "void",
        "yield",
    }


def lexical_view(text):
    """Blank comments and mark non-code positions without executing TypeScript."""
    output = list(text)
    code = [True] * len(text)
    index = 0
    quote = None
    regex_literal = False
    regex_class = False
    line_comment = False
    block_comment = False
    while index < len(text):
        char = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if line_comment:
            code[index] = False
            if char == "\n":
                line_comment = False
            else:
                output[index] = " "
        elif block_comment:
            code[index] = False
            if char == "*" and following == "/":
                output[index] = output[index + 1] = " "
                code[index + 1] = False
                block_comment = False
                index += 1
            elif char != "\n":
                output[index] = " "
        elif regex_literal:
            code[index] = False
            if char != "\n":
                output[index] = " "
            if char == "\\" and index + 1 < len(text):
                code[index + 1] = False
                output[index + 1] = " "
                index += 1
            elif char == "[" and not regex_class:
                regex_class = True
            elif char == "]" and regex_class:
                regex_class = False
            elif char == "/" and not regex_class:
                regex_literal = False
        elif quote:
            code[index] = False
            if char == "\\" and index + 1 < len(text):
                code[index + 1] = False
                index += 1
            elif char == quote:
                quote = None
        elif char in "'\"`":
            code[index] = False
            quote = char
        elif char == "/" and following == "/":
            output[index] = output[index + 1] = " "
            code[index] = code[index + 1] = False
            line_comment = True
            index += 1
        elif char == "/" and following == "*":
            output[index] = output[index + 1] = " "
            code[index] = code[index + 1] = False
            block_comment = True
            index += 1
        elif char == "/" and regex_can_start(text, code, index):
            output[index] = " "
            code[index] = False
            regex_literal = True
        index += 1
    return "".join(output), code


def code_matches(pattern, text, code):
    return [match for match in pattern.finditer(text) if code[match.start()]]


def call_matches(pattern, text, code):
    """Return bare/context calls, excluding any other member receiver."""
    matches = []
    for match in code_matches(pattern, text, code):
        previous = previous_code_index(text, code, match.start())
        if previous < 0 or text[previous] != ".":
            matches.append(match)
    return matches


def extract_text(text, filename="tools.ts"):
    visible, code = lexical_view(text)
    found = [match.group(1) for match in call_matches(REGISTER, visible, code)]
    declaration_pattern = re.compile(
        r"\b(?:export\s+)?const\s+(\w+)\s*=\s*\{([\s\S]*?)\n\}"
    )
    declarations = {}
    for match in code_matches(declaration_pattern, visible, code):
        declarations[match.group(1)] = dict(
            re.findall(r"\b(\w+)\s*:\s*['\"]([^'\"]+)", match.group(2))
        )
    member_pattern = re.compile(
        CALL_PREFIX
        + r"(?:registerTool|accountTool|zoneTool)(?:<[^>]+>)?"
        r"\s*\(\s*(\w+)\.(\w+)"
    )
    for match in call_matches(member_pattern, visible, code):
        owner, member = match.groups()
        if owner in declarations and member in declarations[owner]:
            found.append(declarations[owner][member])
    if filename == "integrations.tools.ts":
        loop = re.compile(r"toolDefinitions\.forEach[\s\S]*?accountTool\(\s*name\s*,")
        definitions = re.compile(r"\btoolDefinitions[^=]*=\s*\[([\s\S]*?)\n\]")
        if code_matches(loop, visible, code):
            matches = code_matches(definitions, visible, code)
            if matches:
                found.extend(re.findall(r"\bname\s*:\s*['\"]([^'\"]+)", matches[0].group(1)))
    return found


def self_test():
    source = r'''
// registerTool("comment_fake")
const quoted = 'registerTool("string_fake")';
const templated = `accountTool("template_fake")`;
const regex = /registerTool("regex_fake")/;
const regexClass = /[/]zoneTool("regex_class_fake")/;
/* zoneTool("block_fake") */
foreign.registerTool("foreign_fake");
server.registerTool("server_fake");
foreign . registerTool("spaced_foreign_fake");
foreign /* comment */ . registerTool("commented_foreign_fake");
if (ready) /registerTool("conditional_regex_fake")/.test(value);
else /accountTool("else_regex_fake")/.test(value);
context.registerTool("context_tool");
registerTool("direct_tool");
const names = {
  search: "object_tool"
}
accountTool(names.search, {});
const hyperdrive_config_create = "declaration_only";
'''
    actual = extract_text(source)
    if actual != ["context_tool", "direct_tool", "object_tool"]:
        raise SystemExit(f"extractor self-test failed: {actual}")
    casb = '''const toolDefinitions = [
  { name: "casb_tool" }
]
toolDefinitions.forEach(({ name }) => accountTool(name, {}));
'''
    if extract_text(casb, "integrations.tools.ts") != ["casb_tool"]:
        raise SystemExit("extractor CASB self-test failed")
    print("extractor self-test: ok")


if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
    self_test()
    raise SystemExit(0)

root = pathlib.Path(
    sys.argv[1] if len(sys.argv) > 1
    else pathlib.Path.home() / "Dev/_third-party/mcp-server-cloudflare"
)
catalog_path = pathlib.Path(__file__).parents[1] / "capabilities/cloudflare-mcp-parity.json"
try:
    head = subprocess.check_output(
        ["git", "-C", str(root), "rev-parse", "HEAD"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).strip()
except (OSError, subprocess.CalledProcessError) as error:
    raise SystemExit(f"source is not a readable Git checkout: {root}") from error
if head != COMMIT:
    raise SystemExit(f"wrong source HEAD: {head}; expected {COMMIT}")

try:
    tree = subprocess.check_output(
        ["git", "-C", str(root), "ls-tree", "-r", "--name-only", COMMIT, "--", "apps", "packages/mcp-common/src"],
        text=True,
        stderr=subprocess.DEVNULL,
    ).splitlines()
    paths = []
    for name in tree:
        parts = pathlib.PurePosixPath(name).parts
        in_app_sources = len(parts) >= 4 and parts[0] == "apps" and parts[2] in {"src", "server"}
        in_common_sources = len(parts) >= 4 and parts[:3] == ("packages", "mcp-common", "src")
        if name.endswith(".ts") and ".spec." not in parts[-1] and (in_app_sources or in_common_sources):
            paths.append(name)
    found = []
    for name in paths:
        blob = subprocess.check_output(
            ["git", "-C", str(root), "cat-file", "blob", f"{COMMIT}:{name}"],
            stderr=subprocess.DEVNULL,
        )
        found.extend(extract_text(blob.decode("utf-8", errors="ignore"), pathlib.PurePosixPath(name).name))
except (OSError, subprocess.CalledProcessError) as error:
    raise SystemExit(f"could not read pinned source blobs at {COMMIT}") from error

catalog = json.loads(catalog_path.read_text())
actual = {item["name"] for item in catalog["capabilities"]}
duplicates = sorted(name for name in set(found) if found.count(name) > 1)
missing = sorted(set(found) - actual)
extra = sorted(actual - set(found))
print(json.dumps({
    "source_commit": head,
    "source_count": len(found),
    "catalog_count": len(actual),
    "duplicates": duplicates,
    "missing": missing,
    "extra": extra,
}, indent=2))
raise SystemExit(bool(duplicates or missing or extra))